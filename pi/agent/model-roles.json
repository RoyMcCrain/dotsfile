{
  "description": "Single source of truth for model IDs. Skills resolve roles via resolve-model.sh; run --apply to sync enabledModels into settings.json. defaultModel is runtime state owned by Pi and is intentionally not managed here. parallel-review picks a tier from reviewLevels (1=light, 2=standard, 3=deep); tiers select model precision and fixed attempt budgets. Per-tier attempt budgets live in reviewTimeouts (initial/retry seconds); resolve with --review-level N. single-reviewer skills use the review.* roles, which are defined separately and may differ from a tier's models. Roles name one model per consumer: .pi for Pi headless, .cursor for Cursor Agent CLI (resolve with --field cursor), .id for other tools such as Codex.",
  "enabledModels": [
    "xai/grok-4.6",
    "anthropic/claude-sonnet-5:high",
    "anthropic/claude-sonnet-5:max",
    "anthropic/claude-opus-5:high",
    "anthropic/claude-opus-5:max",
    "openai-codex/gpt-5.6-sol:xhigh",
    "openai-codex/gpt-5.6-sol:max",
    "openai-codex/gpt-5.6-terra:high",
    "openai-codex/gpt-5.6-terra:max",
    "sakana-ai-console/fugu:high",
    "sakana-ai-console/fugu-ultra:high"
  ],
  "roles": {
