{
  "description": "Single source of truth for model IDs. Skills resolve roles via resolve-model.sh; run --apply to sync enabledModels into settings.json. defaultModel is runtime state owned by Pi and is intentionally not managed here. parallel-review picks a tier from reviewLevels (1=light, 2=standard, 3=deep); tiers change precision (model/thinking) only. Each reviewer's timeout is computed from patch size as base + perKb*KB (capped by the skill), so time scales with the change, not the tier. single-reviewer skills use the review.* roles, which are defined separately and may differ from a tier's models. Roles name one model per consumer: .pi for Pi headless, .cursor for Cursor Agent CLI (resolve with --field cursor), .id for other tools such as Codex.",
  "enabledModels": [
    "xai/grok-4.6",
    "anthropic/claude-sonnet-5:high",
    "anthropic/claude-sonnet-5:max",
    "anthropic/claude-opus-5:high",
    "anthropic/claude-opus-5:max",
    "openai-codex/gpt-5.6-sol:xhigh",
    "openai-codex/gpt-5.6-sol:max",
    "openai-codex/gpt-5.6-terra:high",
    "openai-codex/gpt-5.6-terra:max",
    "sakana-ai-console/fugu:high",
    "sakana-ai-console/fugu-ultra:high"
  ],
  "roles": {
    "review.codex": {
      "pi": "openai-codex/gpt-5.6-terra:high",
      "label": "Codex GPT-5.6 Terra High"
    },
    "review.claude": {
