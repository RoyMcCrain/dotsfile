{
  "description": "Single source of truth for model IDs. parallel-review selects offline review tiers (1..2; unspecified/auto means L1), each with exactly two Pi reviewers in Codex then Claude order. Tier attempt budgets live in reviewTimeouts. Roles name one model per consumer: .pi for Pi headless, .agy for Antigravity CLI (resolve with --field agy), .cursor for Cursor Agent CLI (resolve with --field cursor), .id for other tools such as Codex.",
  "enabledModels": [
    "xai/grok-4.7",
    "anthropic/claude-sonnet-5-5:high",
    "anthropic/claude-sonnet-5-5:max",
    "anthropic/claude-opus-5-5:high",
    "anthropic/claude-opus-5-5:max",
    "openai/gpt-6-astra:xhigh",
    "openai/gpt-6-astra:max",
    "openai/gpt-6.1-sol:xhigh",
    "openai/gpt-6.1-sol:max",
    "openai/gpt-6-luna:high",
    "sakana-ai-console/fugu-max:high",
    "sakana-ai-console/fugu-ultra-v2.0:high",
    "meta/muse-spark-1.3",
    "meta/muse-wonder-1.0",
    "opencode-go/*"
  ],
  "roles": {
    "review.codex": {
      "pi": "openai/gpt-6-astra:high",
      "label": "Codex GPT-6 Astra High"
    },
    "review.claude": {
      "pi": "anthropic/claude-opus-5-5:high",
      "label": "Claude Opus 5.5 High"
    },
    "review.grok": {
      "pi": "xai/grok-4.7",
      "label": "Grok 4.7 (xAI review)",
      "timeout": 120
    },
    "review.antigravity": {
      "agy": "gemini-4-argon-high",
      "label": "Gemini 4 Argon High (Antigravity)"
    },
    "review.fugu": {
      "pi": "sakana-ai-console/fugu-ultra-v2.0:high",
      "label": "Sakana Fugu Ultra v2 High",
      "timeout": 240
    },
    "review.muse": {
      "pi": "meta/muse-spark-1.3:high",
      "label": "Muse Spark 1.3 High",
      "timeout": 120
    },
    "review.deepseek": {
      "pi": "opencode-go/deepseek-v4.1-flash:high",
      "label": "DeepSeek V4.1 Flash High"
    },
    "route.fugu.base": {
      "id": "fugu-max",
      "label": "Sakana Fugu Max"
    },
    "route.fugu.ultra": {
      "id": "fugu-ultra-v2.0",
      "label": "Sakana Fugu Ultra v2"
    },
    "impl.default": {
      "pi": "openai/gpt-6-luna:high",
      "label": "GPT-6 Luna High"
    },
    "impl.deepseek": {
      "pi": "opencode-go/deepseek-v4.1-flash:high",
      "label": "DeepSeek V4.1 Flash High"
    },
    "impl.haiku": {
      "pi": "opencode-go/claude-haiku-5-5:high",
      "label": "Claude Haiku 5.5 High"
    },
    "research.xai": {
      "pi": "xai/grok-4.7",
      "label": "Grok 4.7 (X Search research)"
    },
    "codex.default": {
      "id": "gpt-6-astra",
      "label": "Codex GPT-6 Astra"
    }
  },
  "reviewTimeouts": {
    "1": { "initial": 600, "retry": 600 },
    "2": { "initial": 600, "retry": 900 }
  },
  "reviewLevels": {
    "1": [
      {
        "pi": "openai/gpt-6.1-sol:xhigh"
      },
      {
        "pi": "anthropic/claude-opus-5-5:high"
      }
    ],
    "2": [
      {
        "pi": "openai/gpt-6-astra:max"
      },
      {
        "pi": "anthropic/claude-opus-5-5:max"
      }
    ]
  }
}
