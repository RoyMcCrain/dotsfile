{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "xhigh",
  "theme": "dark",
  "shellPath": "~/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/bash",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 50000,
    "keepRecentTokens": 6000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "extensions": [
    "extensions/*.ts",
    "-extensions/auto-continue-after-compact.ts",
    "-extensions/local-openai.ts",
    "-extensions/openrouter-balance.ts",
    "-extensions/save-compaction-log.ts"
  ],
  "lastChangelogVersion": "1.6.0",
  "packages": [
    "https://github.com/earendil-works/pi-claude-code@d5b5e04c314d3452d357174d16d10dda34daa2d2",
    "npm:pi-muse-provider"
  ],
  "prompts": [
    "~/.agents/skills/explainer/prompts"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-muse-provider\",\"scope\":\"user\"}": "0.1.3"
  }
}