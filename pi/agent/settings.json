{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "xai/grok-4.7",
    "anthropic/claude-sonnet-5-5:high",
    "anthropic/claude-sonnet-5-5:max",
    "anthropic/claude-opus-5-5:high",
    "anthropic/claude-opus-5-5:max",
    "openai/gpt-6-astra:xhigh",
    "openai/gpt-6-astra:max",
    "openai/gpt-6.1-sol:xhigh",
    "openai/gpt-6.1-sol:max",
    "openai/gpt-6-luna:high",
    "sakana-ai-console/fugu-max:high",
    "sakana-ai-console/fugu-ultra-v2.0:high",
    "meta/muse-spark-1.3",
    "meta/muse-wonder-1.0",
    "opencode-go/*"
  ],
  "theme": "dark",
  "shellPath": "~/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/bash",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 50000,
    "keepRecentTokens": 6000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "extensions": [
    "extensions/*.ts"
  ],
  "lastChangelogVersion": "1.2.0",
  "packages": [],
  "prompts": ["~/.agents/skills/explainer/prompts"]
}
