{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "theme": "dark",
  "shellPath": "~/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/bash",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 50000,
    "keepRecentTokens": 6000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "extensions": [
    "extensions/*.ts",
    "-extensions/auto-fugu-model.ts",
    "-extensions/auto-continue-after-compact.ts",
    "-extensions/local-openai.ts",
    "-extensions/openrouter-balance.ts",
    "-extensions/save-compaction-log.ts"
  ],
  "lastChangelogVersion": "1.5.2",
  "packages": [],
  "prompts": [
    "~/.agents/skills/explainer/prompts"
  ]
}